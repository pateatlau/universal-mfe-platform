            const helpfulMsg = `Network request failed with both 10.0.2.2 and localhost.\n` +
              `Make sure:\n` +
              `1. The hello-remote dev server is running (npm run hello-remote:serve)\n` +
              `2. For Android emulator, run: adb reverse tcp:9003 tcp:9003\n` +
              `Original error: ${fetchError.message || fetchError}\n` +
