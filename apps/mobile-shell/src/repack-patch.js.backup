      let response;
      let timeoutId;
      try {
        // Use AbortController if available (React Native 0.60+)
        const controller = typeof AbortController !== 'undefined' ? new AbortController() : null;
        if (controller) {
          timeoutId = setTimeout(() => controller.abort(), 10000); // 10 second timeout
        }
        
        const fetchOptions = {
          method: 'GET',
          headers: {
            'Accept': '*/*',
          },
        };
        
        if (controller) {
          fetchOptions.signal = controller.signal;
        }
        
        response = await fetch(url, fetchOptions);
        
        if (timeoutId) {
          clearTimeout(timeoutId);
        }
      } catch (fetchError) {
        if (timeoutId) {
          clearTimeout(timeoutId);
        }
        
        // On Android, if 10.0.2.2 fails, try localhost (in case adb reverse is set up)
        if (Platform.OS === 'android' && url.includes('10.0.2.2')) {
          const localhostUrl = url.replace('10.0.2.2', 'localhost');
          console.log('[Mock ScriptManager] 10.0.2.2 failed, trying localhost (adb reverse may be set up): ' + localhostUrl);
          
          let timeoutId2;
          try {
            const controller2 = typeof AbortController !== 'undefined' ? new AbortController() : null;
            if (controller2) {
              timeoutId2 = setTimeout(() => controller2.abort(), 10000);
            }
            
            const fetchOptions2 = {
              method: 'GET',
              headers: {
                'Accept': '*/*',
              },
            };
            
            if (controller2) {
              fetchOptions2.signal = controller2.signal;
            }
            
            response = await fetch(localhostUrl, fetchOptions2);
            
            if (timeoutId2) {
              clearTimeout(timeoutId2);
            }
            
            console.log('[Mock ScriptManager] Successfully loaded from localhost (adb reverse is active)');
            // Continue with the response
