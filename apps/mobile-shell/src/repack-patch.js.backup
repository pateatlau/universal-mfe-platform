      "./node_modules/webpack/lib/logging/Logger.js",
      "./node_modules/webpack/lib/logging/createConsoleLogger.js",
      "../../node_modules/webpack/lib/logging/Logger.js",
      "../../../node_modules/webpack/lib/logging/Logger.js",
      "../../node_modules/@rspack/core/hot/log.js",
      "../../../node_modules/@rspack/core/hot/log.js",
      "../../node_modules/webpack-dev-server/client/modules/logger/index.js",
    ];
    
