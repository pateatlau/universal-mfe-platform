      warn: () => {},
      info: () => {},
      log: () => {},
      debug: () => {},
      group: () => {},
      groupCollapsed: () => {},
      groupEnd: () => {},
      time: () => {},
      timeEnd: () => {},
      profile: () => {},
      profileEnd: () => {},
      clear: () => {},
      status: () => {},
    };
    
    try {
      console.log('[Mock ScriptManager] Loading: ' + scriptId + ' from ' + url);
      console.log('[Mock ScriptManager] Platform: ' + Platform.OS);
      
