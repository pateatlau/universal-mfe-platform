// Workaround: Create a mock NativeScriptManager module
// This file will be aliased in webpack config to replace the real NativeScriptManager
// when the TurboModule isn't available

const { TurboModuleRegistry, Platform } = require('react-native');

// Try to get the real module first
let realModule = TurboModuleRegistry.get('ScriptManager');

// Helper function to get the correct URL for a remote
// Handles platform-specific URL adjustments (Android emulator needs 10.0.2.2)
function getRemoteUrl(scriptId) {
  try {
    // Try to load the remotes config
    const remotes = require('./config/remotes').remotes;
    if (remotes && remotes[scriptId] && remotes[scriptId].entry) {
      let url = remotes[scriptId].entry;
      
      // For Android emulator, replace localhost with 10.0.2.2
      // 10.0.2.2 is the special IP that Android emulator uses to access host machine's localhost
      if (Platform.OS === 'android' && url.includes('localhost')) {
        url = url.replace('localhost', '10.0.2.2');
        console.log('[Mock ScriptManager] Android detected, using 10.0.2.2 instead of localhost');
      }
      
      return url;
    }
  } catch (e) {
    // Config might not be available yet, fall through to hardcoded map
    console.warn('[Mock ScriptManager] Could not load remotes config:', e.message);
  }
  
  // Fallback to hardcoded map
  // Use port 9004 for Re.Pack-built mobile remote entry
  const remoteUrlMap = {
    'hello_remote': 'http://localhost:9004/remoteEntry.js',
  };
  
  let url = remoteUrlMap[scriptId];
  
  // For Android emulator, replace localhost with 10.0.2.2
  if (Platform.OS === 'android' && url && url.includes('localhost')) {
    url = url.replace('localhost', '10.0.2.2');
    console.log('[Mock ScriptManager] Android detected, using 10.0.2.2 instead of localhost');
  }
  
  return url;
}

// If not found, create a mock that satisfies the TurboModule interface
// The mock needs to be a proper object with all expected properties AND a prototype
// Module Federation checks for prototype, so we need to ensure it exists
function MockScriptManager() {
  // This constructor ensures the mock has a proper prototype chain
}

// Add methods to the prototype to satisfy Module Federation's prototype checks
// The actual signature is: loadScript(scriptId, caller, context, entry)
// where entry is the URL string
MockScriptManager.prototype.loadScript = async function(scriptId, caller, context, entry) {
  // For Module Federation, we need to actually load the script
  // Since we don't have the native module, we'll use fetch + eval as a fallback
  // Try multiple ways to extract the URL
  let url = entry;
  if (!url && context) {
    // Check locator.url first (Module Federation v2 uses this)
    url = context.locator?.url || context.url || context.referenceUrl || context.entry;
  }
  
  // If entry is an object, try to extract URL from it
  if (url && typeof url === 'object') {
    url = url.url || url.entry || url.href;
  }
  
  // If still no URL, try to construct it from the scriptId (remote name)
  if (!url && scriptId) {
    url = getRemoteUrl(scriptId);
  }
  
  // If we have a URL string, adjust it for Android if needed
  // This must happen AFTER we've extracted the URL from all possible sources
  if (url && typeof url === 'string' && Platform.OS === 'android' && url.includes('localhost')) {
    url = url.replace('localhost', '10.0.2.2');
    console.log('[Mock ScriptManager] Adjusted URL for Android: ' + url);
  }
  
