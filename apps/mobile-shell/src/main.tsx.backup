// Patch TurboModuleRegistry.getEnforcing early to prevent errors
// This must happen before any code tries to use ScriptManager
// We create a simple mock here that will be replaced by the full mock from repack-patch
const { TurboModuleRegistry } = require('react-native');
const originalGetEnforcing = TurboModuleRegistry.getEnforcing;
if (originalGetEnforcing) {
  TurboModuleRegistry.getEnforcing = function(moduleName) {
    if (moduleName === 'ScriptManager') {
      // Try to get the real module first
      const realModule = TurboModuleRegistry.get('ScriptManager');
      if (realModule) {
        return realModule;
      }
      // If not found, create a temporary mock to prevent errors
      // The full mock from repack-patch will replace this later
      console.warn('[MobileShell] ScriptManager TurboModule not found, using temporary mock');
      return {
        loadScript: () => Promise.resolve(null),
        prefetchScript: () => Promise.resolve(null),
        invalidateScripts: () => Promise.resolve(null),
        unstable_evaluateScript: () => true,
      };
    }
    return originalGetEnforcing.call(this, moduleName);
  };
}

import { AppRegistry } from 'react-native';
import App from './app/App';

AppRegistry.registerComponent('MobileShell', () => App);
