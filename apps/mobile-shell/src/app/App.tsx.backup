import React, { useState } from 'react';
import { View, Text, Pressable, StyleSheet } from 'react-native';

// Remote loading function
async function loadRemoteComponent() {
  // Debug: Check what's available in globalThis
  console.log('[App] Checking for container in globalThis...');
  console.log('[App] globalThis.hello_remote:', typeof globalThis.hello_remote);
  console.log('[App] globalThis keys:', Object.keys(globalThis).filter(k => k.includes('hello') || k.includes('remote')));
  
  // Check multiple possible locations for the container
  const container = 
    globalThis.hello_remote ||
    globalThis['hello_remote'] ||
    (globalThis.__webpack_require__ && globalThis.__webpack_require__.cache && globalThis.__webpack_require__.cache['hello_remote']) ||
    (globalThis.__webpack_require__ && globalThis.__webpack_require__.federation && globalThis.__webpack_require__.federation.instance);
  
  if (container && container.get) {
    try {
      console.log('[App] Loading module from container directly');
      const moduleFactory = await container.get('./HelloRemote');
      const module = moduleFactory();
      return module.HelloRemote || module.default || module;
    } catch (e) {
      console.error('[App] Failed to load from container:', e);
    }
  }
  
  // Fallback to import if container not available
  try {
    console.log('[App] Attempting to load via import');
    const container = await import('hello_remote/HelloRemote');
    return container.HelloRemote || container.default;
  } catch (error) {
    console.error('[App] Failed to load remote via import:', error);
    throw error;
  }
}

const App = () => {
  const [RemoteComponent, setRemoteComponent] = useState<React.ComponentType | null>(null);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);

  const handleLoadRemote = async () => {
    // Prevent multiple simultaneous loads
    if (loading) {
      return;
    }
    
    setLoading(true);
    setError(null);
    try {
      const Component = await loadRemoteComponent();
      if (Component) {
        setRemoteComponent(() => Component);
      } else {
        setError('Failed to load component');
      }
    } catch (err) {
      const errorMessage = err instanceof Error ? err.message : 'Failed to load remote';
      console.error('Failed to load remote:', err);
      setError(errorMessage);
    } finally {
      setLoading(false);
    }
  };

  return (
    <View style={styles.container}>
      <Text style={styles.title}>Universal MFE Seed</Text>
      <Pressable style={styles.button} onPress={handleLoadRemote} disabled={loading}>
        <Text style={styles.buttonText}>
          {loading ? 'Loading...' : 'Load Hello Remote'}
        </Text>
      </Pressable>
      {error && (
        <Text style={styles.errorText}>Error: {error}</Text>
      )}
      {RemoteComponent && (
        <View style={styles.remoteContainer}>
          <RemoteComponent />
        </View>
      )}
    </View>
  );
};

const styles = StyleSheet.create({
  container: {
    flex: 1,
    padding: 20,
    alignItems: 'center',
    justifyContent: 'center',
    backgroundColor: '#ffffff',
  },
  title: {
    fontSize: 32,
    fontWeight: 'bold',
    marginBottom: 30,
    color: '#000000',
  },
  button: {
    backgroundColor: '#007AFF',
    paddingHorizontal: 30,
    paddingVertical: 15,
    borderRadius: 8,
    marginBottom: 20,
  },
  buttonText: {
    color: '#ffffff',
    fontSize: 18,
    fontWeight: '600',
  },
  remoteContainer: {
    marginTop: 20,
    width: '100%',
    alignItems: 'center',
  },
});

export default App;
